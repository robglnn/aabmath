    "kp.alg1.order.ops",
    "kp.alg1.eval.substitute",
    "kp.alg1.eval.multi.var"
  ],
  "masteryThreshold": 0.8,
  "worldHook": {
    "siteId": "lesson_board_2",
    "unlockOnMastery": [
      "lesson_board_3"
    ]
  },
  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will evaluate numerical and algebraic expressions by substituting values and applying order of operations.",
        "es": "Evaluarás expresiones numéricas y algebraicas sustituyendo valores y aplicando el orden de operaciones.",
        "pl": "Będziesz obliczać wyrażenia liczbowe i algebraiczne przez podstawianie wartości i stosowanie kolejności działań."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: substitute, then PEMDAS/GEMDAS",
        "es": "Enseñar: sustituir, luego PEMDAS/GEMDAS",
        "pl": "Nauczanie: podstaw, potem kolejność działań"
      },
      "body": {
        "en": "Replace each variable with its value (use parentheses for negatives). Then: Grouping → Exponents → Multiply/Divide (left to right) → Add/Subtract (left to right).",
        "es": "Reemplaza cada variable por su valor (usa paréntesis para negativos). Luego: Agrupación → Exponentes → Multiplicar/Dividir (izq. a der.) → Sumar/Restar (izq. a der.).",
        "pl": "Zamień każdą zmienną na wartość (nawiasy przy ujemnych). Potem: Grupowanie → Potęgi → Mnożenie/Dzielenie (od lewej) → Dodawanie/Odejmowanie (od lewej)."
      },
      "bodyMath": [
        "3 + 4 \\cdot 2 = 11",
        "2x + 1 \\text{ for } x = 5",
        "2(5 + 3) - 4 = 12"
      ],
      "itemIds": [
        "alg1-l02-t01",
        "alg1-l02-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Check signs after substituting negatives and keep multiply/divide left-to-right.",
        "es": "Revisa los signos al sustituir negativos y mantén multiplicar/dividir de izquierda a derecha.",
        "pl": "Sprawdzaj znaki po podstawieniu ujemnych i trzymaj mnożenie/dzielenie od lewej."
      },
      "itemIds": [
        "alg1-l02-g01",
        "alg1-l02-g02",
        "alg1-l02-g03",
        "alg1-l02-g04",
        "alg1-l02-g05"

      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will write y = mx + b from slope and intercept, from a point and slope or two points, and recognize parallel lines by equal slopes.",
        "es": "Escribirás y = mx + b a partir de pendiente e intersección, de un punto y pendiente o dos puntos, y reconocerás paralelas por pendientes iguales.",
        "pl": "Będziesz zapisywać y = mx + b z nachylenia i przecięcia, z punktu i nachylenia lub dwóch punktów oraz rozpoznawać równoległe po równych nachyleniach."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: build equations & parallel slopes",
        "es": "Enseñar: construir ecuaciones y pendientes paralelas",
        "pl": "Nauczanie: budowa równań i nachylenia równoległe"
      },
      "body": {
        "en": "Given m and b, write y = mx + b. Given a point and slope, substitute to find b. Parallel lines share m but usually not b.",
        "es": "Dados m y b, escribe y = mx + b. Dados un punto y pendiente, sustituye para hallar b. Las paralelas comparten m pero normalmente no b.",
        "pl": "Mając m i b, zapisz y = mx + b. Mając punkt i nachylenie, podstaw by znaleźć b. Równoległe mają to samo m, zwykle inne b."
      },
      "bodyMath": [
        "y = mx + b",
        "y_1 = m x_1 + b",
        "m_{\\parallel} = m"
      ],
      "itemIds": [
        "alg1-l08-t01",
        "alg1-l08-t02"
      ]
    },

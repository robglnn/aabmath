  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will simplify, multiply, and divide simple rational expressions by canceling factors.",
        "es": "Simplificarás, multiplicarás y dividirás expresiones racionales simples cancelando factores.",
        "pl": "Będziesz upraszczać, mnożyć i dzielić proste wyrażenia wymierne przez skracanie czynników."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: cancel factors",
        "es": "Enseñar: cancelar factores",
        "pl": "Nauczanie: skracanie czynników"
      },
      "body": {
        "en": "Factor first. Cancel only common factors (never terms in a sum). Division = multiply by the reciprocal.",
        "es": "Factoriza primero. Cancela solo factores comunes (nunca términos de una suma). División = multiplicar por el recíproco.",
        "pl": "Najpierw rozłóż. Skracaj tylko wspólne czynniki (nigdy składników sumy). Dzielenie = mnożenie przez odwrotność."
      },
      "bodyMath": [
        "\\frac{ac}{bc}=\\frac{a}{b}",
        "\\frac{a}{b}\\div\\frac{c}{d}=\\frac{a}{b}\\cdot\\frac{d}{c}",
        "\\frac{x^{2}-9}{x-3}=x+3\\ (x\\ne 3)"
      ],
      "itemIds": [
        "alg1-l21-t01",
        "alg1-l21-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Simplify monomials and binomials, then multiply and divide with canceling.",
        "es": "Simplifica monomios y binomios; luego multiplica y divide cancelando.",
        "pl": "Upraszczaj jednomiany i dwumiany; potem mnoż i dziel ze skracaniem."
      },
      "itemIds": [
        "alg1-l21-g01",
        "alg1-l21-g02",

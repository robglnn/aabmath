    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will multiply polynomials by distributing a monomial and by FOIL (and beyond) for binomials, then combine like terms.",
        "es": "Multiplicarás polinomios distribuyendo un monomio y con FOIL (y más) para binomios, luego combinarás términos semejantes.",
        "pl": "Będziesz mnożyć wielomiany przez rozdzielanie jednomianu oraz FOIL (i dalej) dla dwumianów, potem łączyć wyrazy podobne."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: distribute & FOIL",
        "es": "Enseñar: distribuir y FOIL",
        "pl": "Nauczanie: rozdzielność i FOIL"
      },
      "body": {
        "en": "Distribute the outside factor to every inside term. For two binomials, form all four products (FOIL) and combine like terms.",
        "es": "Distribuye el factor exterior a cada término interior. Para dos binomios, forma los cuatro productos (FOIL) y combina semejantes.",
        "pl": "Rozdziel czynnik zewnętrzny na każdy wyraz wewnątrz. Dla dwóch dwumianów utwórz cztery iloczyny (FOIL) i połącz podobne."
      },
      "bodyMath": [
        "3x(2x + 5) = 6x^{2} + 15x",
        "(x + 2)(x + 3) = x^{2} + 5x + 6",
        "(2x - 5)(2x + 5) = 4x^{2} - 25"
      ],
      "itemIds": [
        "alg1-l13-t01",
        "alg1-l13-t02"
      ]
    },

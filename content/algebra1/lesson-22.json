  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will solve absolute value equations and inequalities using distance and compound cases.",
        "es": "Resolverás ecuaciones y desigualdades de valor absoluto usando distancia y casos compuestos.",
        "pl": "Będziesz rozwiązywać równania i nierówności z wartością bezwzględną przez odległość i przypadki złożone."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: distance & cases",
        "es": "Enseñar: distancia y casos",
        "pl": "Nauczanie: odległość i przypadki"
      },
      "body": {
        "en": "|expression| is distance. Equations split into ± cases when the right side is nonnegative; inequalities use AND for < and OR for >.",
        "es": "|expresión| es distancia. Las ecuaciones se dividen en casos ± si el lado derecho es no negativo; desigualdades usan Y para < y O para >.",
        "pl": "|wyrażenie| to odległość. Równania rozdzielają się na przypadki ±, gdy prawa strona jest nieujemna; nierówności używają I dla < i LUB dla >."
      },
      "bodyMath": [
        "|x|=c\\Rightarrow x=\\pm c\\ (c\\ge 0)",
        "|x|<c\\Rightarrow -c<x<c",
        "|x|>c\\Rightarrow x<-c\\ \\vee\\ x>c"
      ],
      "itemIds": [
        "alg1-l22-t01",
        "alg1-l22-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Evaluate absolute values, solve two-branch equations, and rewrite inequalities with AND/OR.",
        "es": "Evalúa valores absolutos, resuelve ecuaciones de dos ramas y reescribe desigualdades con Y/O.",
        "pl": "Obliczaj wartości bezwzględne, rozwiązuj równania dwugałęziowe i przepisuj nierówności z I/LUB."
      },
      "itemIds": [

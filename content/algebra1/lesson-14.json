  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will factor out GCFs and factor x² + bx + c (a=1), then verify by multiplying.",
        "es": "Sacarás el MCD y factorizarás x² + bx + c (a=1), luego verificarás multiplicando.",
        "pl": "Będziesz wyłączać NWD i rozkładać x² + bx + c (a=1), potem sprawdzać przez mnożenie."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: GCF & (x+p)(x+q)",
        "es": "Enseñar: MCD y (x+p)(x+q)",
        "pl": "Nauczanie: NWD i (x+p)(x+q)"
      },
      "body": {
        "en": "Pull the greatest common factor first. For x² + bx + c, find integers p,q with p+q=b and p·q=c.",
        "es": "Saca primero el máximo común divisor. Para x² + bx + c, halla enteros p,q con p+q=b y p·q=c.",
        "pl": "Najpierw wyłącz największy wspólny dzielnik. Dla x² + bx + c znajdź całkowite p,q: p+q=b, p·q=c."
      },
      "bodyMath": [
        "6x + 9 = 3(2x + 3)",
        "x^{2} + 5x + 6 = (x + 2)(x + 3)",
        "(x + 2)(x + 5) = x^{2} + 7x + 10"
      ],
      "itemIds": [
        "alg1-l14-t01",
        "alg1-l14-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Factor GCFs with variables, practice mixed-sign trinomials, and check by expanding.",
        "es": "Factoriza MCD con variables, practica trinomios con signos mixtos y comprueba expandiendo.",
        "pl": "Rozkładaj NWD ze zmiennymi, ćwicz trójmiany z mieszanymi znakami i sprawdzaj rozwijając."
      },
      "itemIds": [

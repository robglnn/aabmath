  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will interpret inequality symbols on a number line and solve one- and two-step linear inequalities, flipping when multiplying or dividing by a negative.",
        "es": "Interpretarás símbolos de desigualdad en la recta y resolverás desigualdades lineales de uno y dos pasos, invirtiendo al multiplicar o dividir por un negativo.",
        "pl": "Będziesz interpretować symbole nierówności na osi i rozwiązywać jedno- oraz dwukrokowe nierówności liniowe, odwracając przy mnożeniu lub dzieleniu przez ujemną."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: solution sets and flips",
        "es": "Enseñar: conjuntos solución e inversiones",
        "pl": "Nauczanie: zbiory rozwiązań i odwracanie"
      },
      "body": {
        "en": "An inequality describes a set of numbers. Open circles exclude the endpoint (<, >); closed include it (≤, ≥). Solve like equations, but flip the inequality when you multiply or divide both sides by a negative number.",
        "es": "Una desigualdad describe un conjunto de números. Círculos abiertos excluyen el extremo (<, >); cerrados lo incluyen (≤, ≥). Resuelve como ecuaciones, pero invierte al multiplicar o dividir por un negativo.",
        "pl": "Nierówność opisuje zbiór liczb. Otwarte kółka wykluczają koniec (<, >); zamknięte obejmują (≤, ≥). Rozwiązuj jak równania, ale odwróć nierówność przy mnożeniu lub dzieleniu przez ujemną."
      },
      "bodyMath": [
        "x > 3",
        "x + 4 \\le 10",
        "-2x \\ge 8"
      ],
      "itemIds": [

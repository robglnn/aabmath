{
  "id": "alg1-l11",
  "courseId": "algebra1",
  "order": 11,
  "title": {
    "en": "Exponent Properties — Product, Quotient, Power",
    "es": "Propiedades de exponentes — producto, cociente, potencia",
    "pl": "Własności potęg — iloczyn, iloraz, potęga"
  },
  "knowledgePointIds": [
    "kp.alg1.exponents.product",
    "kp.alg1.exponents.quotient",
    "kp.alg1.exponents.power"
  ],
  "masteryThreshold": 0.8,
  "worldHook": {
    "siteId": "lesson_board_11",
    "unlockOnMastery": [
      "lesson_board_12"
    ]
  },
  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will simplify expressions using product, quotient, and power rules for exponents with the same base.",
        "es": "Simplificarás expresiones usando las reglas de producto, cociente y potencia para exponentes de la misma base.",
        "pl": "Będziesz upraszczać wyrażenia regułami iloczynu, ilorazu i potęgi dla tej samej podstawy."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: three exponent rules",
        "es": "Enseñar: tres reglas de exponentes",
        "pl": "Nauczanie: trzy reguły potęg"
      },
      "body": {
        "en": "Same base: multiply → add exponents; divide → subtract; raise a power to a power → multiply exponents.",
        "es": "Misma base: multiplicar → sumar exponentes; dividir → restar; potenciar una potencia → multiplicar exponentes.",
        "pl": "Ta sama podstawa: mnożenie → dodaj wykładniki; dzielenie → odejmij; potęga potęgi → pomnóż wykładniki."
      },
      "bodyMath": [
        "a^{m} \\cdot a^{n} = a^{m+n}",
        "\\dfrac{a^{m}}{a^{n}} = a^{m-n}",
        "(a^{m})^{n} = a^{mn}"
      ],
      "itemIds": [
        "alg1-l11-t01",
        "alg1-l11-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Apply each rule to numbers and variables; watch for bare factors like m = m^1.",
        "es": "Aplica cada regla a números y variables; vigila factores solos como m = m^1.",
        "pl": "Stosuj każdą regułę do liczb i zmiennych; uważaj na czynniki jak m = m^1."
      },
      "itemIds": [
        "alg1-l11-g01",
        "alg1-l11-g02",
        "alg1-l11-g03",
        "alg1-l11-g04",
        "alg1-l11-g05"
      ]
    },
    {

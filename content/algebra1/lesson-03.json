{
  "id": "alg1-l03",
  "courseId": "algebra1",
  "order": 3,
  "title": {
    "en": "From Expressions to Equations — Equality & Solving Simple Linear Equations",
    "es": "De expresiones a ecuaciones — igualdad y resolución de ecuaciones lineales simples",
    "pl": "Od wyrażeń do równań — równość i rozwiązywanie prostych równań liniowych"
  },
  "knowledgePointIds": [
    "kp.alg1.equation.meaning",
    "kp.alg1.equation.vs.expression",
    "kp.alg1.solve.one.step",
    "kp.alg1.solve.two.step"
  ],
  "masteryThreshold": 0.8,
  "worldHook": {
    "siteId": "lesson_board_3",
    "unlockOnMastery": [
      "lesson_board_4"
    ]
  },
  "sections": [
    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will distinguish expressions from equations, interpret equality, and solve one- and two-step linear equations, checking solutions by substitution.",
        "es": "Distinguirás expresiones de ecuaciones, interpretarás la igualdad y resolverás ecuaciones lineales de uno y dos pasos, verificando por sustitución.",
        "pl": "Będziesz rozróżniać wyrażenia od równań, interpretować równość oraz rozwiązywać jedno- i dwukrokowe równania liniowe, sprawdzając przez podstawienie."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: balance and inverse operations",
        "es": "Enseñar: balance y operaciones inversas",
        "pl": "Nauczanie: równowaga i działania odwrotne"
      },
      "body": {
        "en": "An equation says two expressions are equal. Keep the balance: whatever you do to one side, do to the other. Undo operations in reverse order (usually undo +/− before ·/÷ for ax+b=c).",
        "es": "Una ecuación dice que dos expresiones son iguales. Mantén el equilibrio: lo que hagas a un lado, hazlo al otro. Deshaz operaciones en orden inverso (usualmente +/− antes de ·/÷ para ax+b=c).",
        "pl": "Równanie mówi, że dwa wyrażenia są równe. Zachowaj równowagę: co robisz po jednej stronie, zrób po drugiej. Cofaj działania w odwrotnej kolejności (zwykle +/− przed ·/÷ dla ax+b=c)."
      },
      "bodyMath": [
        "x + 7 = 12",
        "4x = 20",
        "2x + 3 = 11"
      ],
      "itemIds": [
        "alg1-l03-t01",
        "alg1-l03-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Check candidate solutions by substitution. For two-step equations, undo addition/subtraction before multiplication/division.",
        "es": "Verifica soluciones candidatas por sustitución. En dos pasos, deshaz suma/resta antes de multiplicación/división.",
        "pl": "Sprawdzaj rozwiązania przez podstawienie. W dwóch krokach cofaj dodawanie/odejmowanie przed mnożeniem/dzieleniem."
      },
      "itemIds": [

    {
      "phase": "objective",
      "title": {
        "en": "Learning objective",
        "es": "Objetivo de aprendizaje",
        "pl": "Cel nauki"
      },
      "body": {
        "en": "You will recognize linear functions, find constant rates of change from tables and contexts, and compute slope as rise over run.",
        "es": "Reconocerás funciones lineales, hallarás tasas de cambio constantes en tablas y contextos, y calcularás pendiente como subida sobre avance.",
        "pl": "Będziesz rozpoznawać funkcje liniowe, znajdować stałe stopy zmian z tabel i kontekstów oraz obliczać nachylenie jako wzrost przez przebieg."
      }
    },
    {
      "phase": "teach",
      "title": {
        "en": "Teach: constant rate and slope",
        "es": "Enseñar: tasa constante y pendiente",
        "pl": "Nauczanie: stała stopa i nachylenie"
      },
      "body": {
        "en": "A linear function has a constant rate of change. In y = mx + b, m is that rate (slope). Slope = rise/run = Δy/Δx between two points. Positive slopes rise; negative slopes fall.",
        "es": "Una función lineal tiene tasa de cambio constante. En y = mx + b, m es esa tasa (pendiente). Pendiente = subida/avance = Δy/Δx entre dos puntos. Pendientes positivas suben; negativas bajan.",
        "pl": "Funkcja liniowa ma stałą stopę zmian. W y = mx + b m to ta stopa (nachylenie). Nachylenie = wzrost/przebieg = Δy/Δx między dwoma punktami. Dodatnie rosną; ujemne spadają."
      },
      "bodyMath": [
        "y = 2x + 1",
        "m = \\frac{\\Delta y}{\\Delta x}",
        "y = -4x + 7"
      ],
      "itemIds": [
        "alg1-l06-t01",
        "alg1-l06-t02"
      ]
    },
    {
      "phase": "guided",
      "title": {
        "en": "Guided practice",
        "es": "Práctica guiada",
        "pl": "Ćwiczenia z przewodnikiem"
      },
      "body": {
        "en": "Evaluate linear rules, read rates from tables and contexts, and compute slopes between points.",
        "es": "Evalúa reglas lineales, lee tasas en tablas y contextos, y calcula pendientes entre puntos.",
        "pl": "Obliczaj reguły liniowe, odczytuj stopy z tabel i kontekstów oraz nachylenia między punktami."
      },
      "itemIds": [
